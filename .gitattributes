# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Python source
*.py text diff=python

# Markdown documentation
*.md text
*.rst text

# Config files
*.yml text
*.yaml text
*.toml text
*.json text
*.cfg text
*.ini text

# Security: prevent secret files from appearing in diffs if accidentally created
*.env -diff
*.pem -diff
*.key -diff
*.cert -diff
*.p12 -diff
*.pfx -diff
*.pkcs12 -diff

# Shell / batch scripts
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Web
*.html text diff=html

# Procfile / platform configs
Procfile text
Dockerfile text
Dockerfile.* text
.dockerignore text

# Requirements
requirements.txt text
requirements*.txt text
runtime.txt text

# Binary files - don't modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.pkl binary
*.sqlite binary
*.sqlite3 binary
*.db binary
