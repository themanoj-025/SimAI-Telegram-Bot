# Auto-detect text files and normalize line endings
* text=auto

# Python source
*.py text diff=python

# Markdown documentation
*.md text
*.rst text

# Config files
*.yml text
*.yaml text
*.toml text
*.json text
*.cfg text
*.ini text
*.env text
*.env.example text

# Shell / batch scripts
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text

# Web
*.html text diff=html

# Procfile / platform configs
Procfile text
Dockerfile text
Dockerfile.* text

# Requirements
requirements.txt text
runtime.txt text

# Binary files - don't modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
