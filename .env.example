# AI Telegram News Bot - Environment Template
# Copy to .env and fill in real values. NEVER commit .env.

# Telegram bot token from @BotFather. REQUIRED - the bot will refuse to
# start without it.
TELEGRAM_BOT_TOKEN=

# Default chat id for the 2-hour auto-broadcast. Optional - without it,
# auto-broadcast is disabled but interactive commands still work.
TELEGRAM_CHAT_ID=

# Google Gemini API key used by the AI summarizer. REQUIRED for the
# /summary command and AI-powered features.
GEMINI_API_KEY=

# Optional overrides
# DATABASE_PATH=bot_cache.db
# LOG_FILE=ai_daily_bot.log
